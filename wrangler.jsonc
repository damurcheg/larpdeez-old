// Cloudflare Pages + D1 configuration.
// Docs: https://developers.cloudflare.com/pages/functions/wrangler-configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edu-platform",
  "pages_build_output_dir": "public",
  "compatibility_date": "2025-06-01",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edu-platform",
      "database_id": "6c4be7d7-a385-4f77-9d5a-7bbc1e8102c0"
    }
  ],

  // Optional: durable login rate limiting across isolates (free tier).
  // Create with: npx wrangler kv namespace create RATE_LIMIT
  // Then paste the returned id below and run: npx wrangler pages deploy public
  // "kv_namespaces": [
  //   { "binding": "RATE_LIMIT_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  // ]
}
